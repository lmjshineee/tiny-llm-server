{
  "name": "llm-serving-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "An event-driven, testable lab for LLM inference request scheduling on Apple Silicon.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "demo": "tsx src/cli/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "bench": "tsx src/cli/bench.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
