{
  "name": "llm-serving-lab",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "An event-driven, testable lab for LLM inference request scheduling on Apple Silicon.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "demo": "tsx src/cli/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "bench": "tsx src/cli/bench.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
